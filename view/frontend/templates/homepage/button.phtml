<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.0.37 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var CssClass $css */

$url = $block->getData('url');
$label = $block->getData('label');

?>
<a href="<?= $escaper->escapeUrl((string)$url) ?>"
   class="<?= $escaper->escapeHtml($css('btn btn-primary', 'col-link')) ?>"><?= $escaper->escapeHtml((string)$label) ?>
</a>
