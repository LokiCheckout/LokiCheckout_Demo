<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckoutDemo\Component\Theme\ThemeViewModel;
use Yireo\LokiComponents\Factory\ViewModelFactory;

/**
 * @var Template $block
 * @var ViewModelFactory $viewModelFactory
 * @var ThemeViewModel $viewModel
 */
?>
<div class="order-12 mx-2">
    <select x-model="value" @change="submit">
        <option> -- Select a checkout theme --</option>
        <?php foreach ($viewModel->getThemes() as $theme) : ?>
        <?php $selected = ($viewModel->getValue() === $theme->getName()) ? 'selected' : ''; ?>
        <option <?= $selected ?> value="<?= $theme->getName() ?>"><?= $theme->getLabel() ?></option>
        <?php endforeach; ?>
    </select>
</div>
