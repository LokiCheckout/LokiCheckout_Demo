<?php
declare(strict_types=1);

/** @version 2.0.3 */

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
use Magento\Framework\View\Element\Template;
use LokiCheckout\Demo\Component\Theme\ThemeViewModel;
use Loki\Components\Factory\ViewModelFactory;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var ThemeViewModel $viewModel */
/** @var CssClass $css */

?>
<div class="mb-2">
    <select
        aria-label="<?= $escaper->escapeHtml(__('Select a theme')) ?>"
        name="theme-switcher"
        :value="value"
        @change="submitValue"
        class="<?= /* @noEscape */ $css('form-select w-full disabled:bg-zinc-100') ?>">
        <option value=""> -- <?= $escaper->escapeHtml(__('Select a theme')) ?> --</option>
        <?php foreach ($viewModel->getThemes() as $theme) : ?>
            <?php $selected = ($viewModel->getValue() === $theme->getName()) ? 'selected' : ''; ?>
            <option <?= $escaper->escapeHtml($selected) ?> value="<?= $escaper->escapeHtml($theme->getName()) ?>"><?= $escaper->escapeHtml($theme->getLabel()) ?></option>
        <?php endforeach; ?>
    </select>
</div>
