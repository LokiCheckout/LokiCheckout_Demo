<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Demo\Component\GridLayout\GridLayoutViewModel;
use Loki\Components\Factory\ViewModelFactory;

/** @version 2.0.31 */
/** @var ComponentViewModelInterface $viewModel */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var GridLayoutViewModel $viewModel */
/** @var CssClass $css */
/** @var Escaper $escaper */

?>
<div class="mb-2 md:mb-0">
    <select
        aria-label="<?= $escaper->escapeHtml(__('Select a grid layout')) ?>"
        name="grid-layout-switcher"
        :value="value"
        @change="submitValue"
        class="<?= $escaper->escapeHtml($css('form-select w-full disabled:bg-zinc-100')) ?>">
        <option value=""> -- <?= $escaper->escapeHtml(__('Select a grid layout')) ?> --</option>
        <?php foreach ($viewModel->getGridLayouts() as $gridLayout) : ?>
        <?php $selected = ($viewModel->getValue() === $gridLayout->getName()) ? 'selected' : ''; ?>
        <option <?= $escaper->escapeHtml($selected) ?> value="<?= $escaper->escapeHtml($gridLayout->getName()) ?>"><?= $escaper->escapeHtml($gridLayout->getLabel()) ?></option>
        <?php endforeach; ?>
    </select>
</div>
