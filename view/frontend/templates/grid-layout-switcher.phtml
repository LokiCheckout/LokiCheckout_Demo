<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use LokiCheckout\Demo\Component\GridLayout\GridLayoutViewModel;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\CssClass;

/**
 * @var Template $block
 * @var ViewModelFactory $viewModelFactory
 * @var GridLayoutViewModel $viewModel
 * @var CssClass $css
 */
?>
<div class="mb-2">
    <select
        aria-label="<?= __('Select a grid layout') ?>"
        name="grid-layout-switcher"
        :value="value"
        @change="submitValue"
        class="<?= $css('form-select w-full disabled:bg-zinc-100') ?>">
        <option value=""> -- <?= __('Select a grid layout') ?> --</option>
        <?php foreach ($viewModel->getGridLayouts() as $gridLayout) : ?>
        <?php $selected = ($viewModel->getValue() === $gridLayout->getName()) ? 'selected' : ''; ?>
        <option <?= $selected ?> value="<?= $gridLayout->getName() ?>"><?= $gridLayout->getLabel() ?></option>
        <?php endforeach; ?>
    </select>
</div>
