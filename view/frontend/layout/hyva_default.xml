<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <referenceContainer name="customer.login.container">
            <block name="demo_notice" template="LokiCheckout_Demo::hyva/demo-login.phtml"/>
        </referenceContainer>

        <referenceContainer name="loki-checkout.login.form.after">
            <block
                name="loki-checkout.login.form.after.demo-login-notice"
                template="LokiCheckout_Demo::hyva/demo-login.phtml"/>
        </referenceContainer>

        <referenceBlock name="loki-checkout.login.form">
            <arguments>
                <argument name="tooltip_element" xsi:type="string">loki-checkout-login-form-after-demo-login-notice</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
