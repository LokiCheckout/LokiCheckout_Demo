<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <update handle="loki_checkout_theme_default"/>

    <body>
        <!-- Move agreements to billing step -->
        <referenceBlock name="loki-checkout.steps.billing">
            <container
                name="loki-checkout.steps.billing.agreements-container"
                htmlTag="div"
                htmlClass="card my-4"
            >
                <block name="loki-checkout.steps.billing.agreements-container.title" class="Magento\Framework\View\Element\Text">
                    <arguments>
                        <argument name="text" xsi:type="string">
                            <![CDATA[<h2 class="text-2xl font-medium mb-4">Terms and Conditions</h2>]]>
                        </argument>
                    </arguments>
                </block>
            </container>
        </referenceBlock>

        <move element="loki-checkout.agreements" destination="loki-checkout.steps.billing.agreements-container" as="agreements" />

        <move element="loki-checkout.steps.billing.agreements-container" destination="loki-checkout.steps.billing" after="payment-methods"/>

        <!-- Move newsletter to below email field -->
        <move element="loki-checkout.newsletter" destination="loki-checkout.customer" as="newsletter"/>

        <referenceBlock name="loki-checkout.login">
            <arguments>
                <argument name="css_classes" xsi:type="array">
                    <item name="block" xsi:type="array">
                        <item name="default" xsi:type="string">foobar</item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="loki-checkout.customer.customer_dob">
            <arguments>
                <argument name="field_attributes" xsi:type="array">
                    <item name="x-flatpickr" xsi:type="boolean">true</item>
                </argument>
            </arguments>
        </referenceBlock>

        <move element="loki-checkout.login" destination="loki-checkout.customer" as="login" after="customer_email"/>

        <!-- Additional styling -->
        <referenceContainer name="before.body.end">
            <block template="LokiCheckout_Demo::theme/demo/style.phtml"/>
        </referenceContainer>

        <referenceBlock name="loki-checkout.shipping.address.postcode_nl_toggle">
            <arguments>
                <argument name="field_type" xsi:type="string">switch</argument>
            </arguments>
        </referenceBlock>

        <!--
        <referenceBlock name="loki-checkout.payment.methods">
            <arguments>
                <argument name="css_classes" xsi:type="array">
                    <item name="list" xsi:type="array">
                        <item name="default" xsi:type="string">grid md:grid-cols-2</item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
        -->

        <referenceBlock name="loki-checkout.login.logged-in.logout" template="LokiCheckout_Demo::theme/demo/login/logged-in/logout.phtml"/>

        <referenceBlock name="loki-checkout.login.form">
            <arguments>
                <argument name="button_label" xsi:type="string">Sign in for a faster checkout</argument>
                <argument name="css_classes" xsi:type="array">
                    <item name="button" xsi:type="array">
                        <item name="default" xsi:type="string">underline font-medium hover:no-underline</item>
                    </item>
                </argument>
            </arguments>

            <block name="loki-checkout-demo.login.form.before" as="before"
                   template="LokiCheckout_Demo::theme/demo/login/form/before.phtml"/>
        </referenceBlock>
    </body>
</page>

