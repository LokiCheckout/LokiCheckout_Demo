<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <update handle="loki_checkout_theme_default"/>

    <body>
        <!-- Move agreements to billing step -->
        <referenceBlock name="loki-checkout.steps.billing">
            <container
                name="loki-checkout.steps.billing.agreements-container"
                htmlTag="div"
                htmlClass="card mb-4"
                after="loki-checkout.payment.methods"
                before="loki-checkout.steps.billing.buttons"
            />
        </referenceBlock>

        <move element="loki-checkout.agreements" destination="loki-checkout.steps.billing.agreements-container" as="agreements"/>

        <!-- Move newsletter to below email field -->
        <move element="loki-checkout.newsletter" destination="loki-checkout.customer" as="newsletter"/>

        <!-- Combine email field and login option in one block -->
        <referenceBlock name="loki-checkout.customer">
            <block
                name="loki-checkout.customer.customer_email_container"
                template="LokiCheckout_Demo::theme/demo/email-login.phtml"
                before="-"
            />
        </referenceBlock>

        <move element="loki-checkout.customer.customer_email" destination="loki-checkout.customer.customer_email_container" as="email" before="-" />
        <move element="loki-checkout.login" destination="loki-checkout.customer.customer_email_container" as="login" after="-" />

        <!-- Additional styling -->
        <referenceContainer name="before.body.end">
            <block template="LokiCheckout_Demo::theme/demo/style.phtml"/>
        </referenceContainer>
    </body>
</page>
