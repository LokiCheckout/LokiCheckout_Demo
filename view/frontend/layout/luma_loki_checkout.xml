<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <referenceContainer name="header-wrapper">
            <container htmlTag="div" htmlClass="loki">
                <container htmlTag="div" htmlClass="flex float-right">
                    <block template="LokiCheckout_Demo::theme-switcher-container.phtml">
                        <block name="loki-checkout-demo.theme-switcher" as="theme-switcher"
                               template="LokiCheckout_Demo::theme-switcher.phtml"
                        />
                    </block>

                    <block template="LokiCheckout_Demo::grid-layout-switcher-container.phtml">
                        <block name="loki-checkout-demo.grid-layout-switcher" as="grid-layout-switcher"
                               template="LokiCheckout_Demo::grid-layout-switcher.phtml"
                        />
                    </block>

                    <block name="loki-checkout-demo.tourguide-start"
                           template="LokiCheckout_Demo::tourguide-start.phtml"
                    />
                </container>
            </container>
        </referenceContainer>

        <referenceContainer name="loki.script">
            <block name="loki-checkout-demo.tourguide-js"
                   template="LokiCheckout_Demo::luma/tourguide-js.phtml"
            />
        </referenceContainer>
    </body>
</page>
