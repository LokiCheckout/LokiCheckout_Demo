<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <referenceBlock name="loki-checkout.customer.customer_gender">
            <arguments>
                <argument name="options" xsi:type="array">
                    <item name="male" xsi:type="string">Male</item>
                    <item name="female" xsi:type="string">Female</item>
                    <item name="non-binary" xsi:type="string">Non-binary</item>
                    <item name="self-describe" xsi:type="string">Prefer to self-describe</item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
