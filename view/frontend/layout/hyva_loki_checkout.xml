<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <referenceContainer name="header-content.additional">
            <container htmlTag="div" htmlClass="loki flex float-right" before="-">
                <block template="Yireo_LokiCheckoutDemo::theme-switcher-container.phtml">
                    <block name="loki-checkout-demo.theme-switcher" as="theme-switcher"
                           template="Yireo_LokiCheckoutDemo::theme-switcher.phtml"
                    />
                </block>

                <block template="Yireo_LokiCheckoutDemo::grid-layout-switcher-container.phtml">
                    <block name="loki-checkout-demo.grid-layout-switcher" as="grid-layout-switcher"
                           template="Yireo_LokiCheckoutDemo::grid-layout-switcher.phtml"
                    />
                </block>

                <block name="loki-checkout-demo.tourguide-start"
                       template="Yireo_LokiCheckoutDemo::tourguide-start.phtml"
                />
            </container>
        </referenceContainer>

        <referenceContainer name="loki-scripts">
            <block
                name="loki-checkout-demo.tourguide-js"
                template="Yireo_LokiCheckoutDemo::hyva/tourguide-js.phtml"
            />
        </referenceContainer>
    </body>
</page>
